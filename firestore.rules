rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Farmer user profile documents - only accessible by the owner
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // User-scoped persistent farms collection: users/{uid}/farms/{farmId}
      match /farms/{farmId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /zones/{zoneId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      match /scenarios/{scenarioId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /simulations/{simId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Top-level farms collection: verify tenant ownership
    match /farms/{farmId} {
      allow read: if request.auth != null && (
        resource == null || resource.data.owner_id == request.auth.uid || resource.data.ownerId == request.auth.uid
      );
      allow create: if request.auth != null && (
        request.resource.data.owner_id == request.auth.uid || request.resource.data.ownerId == request.auth.uid
      );
      allow update, delete: if request.auth != null && (
        resource.data.owner_id == request.auth.uid || resource.data.ownerId == request.auth.uid
      );
    }

    // Top-level zones collection
    match /zones/{zoneId} {
      allow read, write: if request.auth != null;
    }

    // Top-level scenarios and simulations
    match /scenarios/{scenarioId} {
      allow read, write: if request.auth != null;
    }

    match /simulations/{simulationId} {
      allow read, write: if request.auth != null;
    }

    match /simulation_results/{resultId} {
      allow read, write: if request.auth != null;
    }
  }
}
