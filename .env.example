# FarmSim AI - Environment Configuration
# Copy this file to .env and adjust values for your environment.

# -----------------------------------------------------------------------------
# Frontend Settings (Vite + React)
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8000
VITE_APP_NAME=FarmSim AI

# -----------------------------------------------------------------------------
# AI Agriculture Simulator Backend (Person 3 Module)
# -----------------------------------------------------------------------------

# AI Provider Configuration (Google Gemini Pro Mode)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Application Settings
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# Scenario Intent Classifier Settings
SCENARIO_CLASSIFIER_THRESHOLD=0.60
SCENARIO_CLASSIFIER_MODEL_PATH=app/models/scenario_classifier.joblib

# Farm Risk Classifier Engine ('rf' or 'xgboost')
FARM_RISK_MODEL_TYPE=rf
FARM_RISK_MODEL_PATH=app/models/farm_risk_model.joblib
FARM_RISK_XGB_MODEL_PATH=app/models/farm_risk_xgboost.joblib
